#!/usr/bin/env python3
"""Thin launcher: finds the package next to this file (also through a symlink) and runs it. Run `cust-codex-status --help`."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "src"))

from cust_codex_status.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
